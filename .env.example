# ============================================================
#  SCHOLARLY — Configuration d'environnement
#  Copie ce fichier en .env et remplis les valeurs manquantes
#  NE JAMAIS committer .env dans Git !
# ============================================================

# ------------------------------------------------------------
# CHOIX DU MODE : "remote" (BD prof) ou "local" (XAMPP)
# Valeur par défaut recommandée pendant le cours : remote
# ------------------------------------------------------------
DB_MODE=remote

# ------------------------------------------------------------
# BASE DE DONNÉES DISTANTE — BD témoin du professeur
# Usage : lecture (GET) — écriture possible mais déconseillée
# ------------------------------------------------------------
DB_REMOTE_HOST=163.123.183.89
DB_REMOTE_PORT=17705
DB_REMOTE_USER=ecole
DB_REMOTE_PASSWORD=peda2026
DB_REMOTE_NAME=ecole2026

# ------------------------------------------------------------
# BASE DE DONNÉES LOCALE — XAMPP sur ta machine
# Usage : écriture (POST/PUT/DELETE) — tests d'intégration
# ------------------------------------------------------------
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=scholarly

# ------------------------------------------------------------
# Prisma lit DATABASE_URL directement.
# Cette variable est construite automatiquement par le code
# selon DB_MODE. Tu peux aussi la forcer manuellement ici
# pour court-circuiter la logique (ex : CI/CD).
# Laisse vide pour utiliser la logique DB_MODE.
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# JWT — Authentification
# Génère un secret fort : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=CHANGE_MOI_avec_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
