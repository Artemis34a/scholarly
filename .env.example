# Connexion MySQL
# Renseigne chaque variable ci-dessous ; DATABASE_URL est construite automatiquement à partir d'elles.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ecole_db

DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Base "shadow" utilisée par Prisma Migrate pour valider les migrations en développement.
# Requise uniquement si l'utilisateur DB_USER n'a pas le droit de créer des bases (CREATE DATABASE).
# Voir https://pris.ly/d/migrate-shadow
SHADOW_DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}_shadow"

JWT_SECRET=
JWT_EXPIRES_IN=24h

PORT=3000
