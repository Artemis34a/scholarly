// prisma/schema.prisma
//
// ⚠️  DATABASE_URL est construite dynamiquement par database.config.ts
//     et injectée via PrismaService({ datasources: { db: { url } } }).
//
//     Pour les commandes CLI Prisma (prisma db push, prisma migrate),
//     positionne DATABASE_URL dans ton .env avant de les lancer :
//
//       # BD locale pour migrer
//       DATABASE_URL="mysql://root:@localhost:3306/scholarly"
//       npx prisma db push
//
//       # BD prof pour inspecter
//       DATABASE_URL="mysql://ecole:peda2026@163.123.183.89:17705/ecole2026"
//       npx prisma db pull   (génère le schéma depuis la BD du prof)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Personne {
  idPers        Int       @id @default(autoincrement())
  nom           String    @db.VarChar(255)
  prenom        String    @db.VarChar(255)
  dateNaissance DateTime? @db.Date
  lieuNaissance String?   @db.VarChar(100)
  mobile        String?   @db.VarChar(15)
  phone         String?   @db.VarChar(15)
  typePersonne  Int       @db.SmallInt
  username      String    @unique @db.VarChar(100)
  password      String    @db.VarChar(100)
  alanyaID      String?   @db.VarChar(15)
  idAdmin       Int?
  created_at    DateTime  @default(now())

  @@map("Personne")
}

model Admin {
  ID         Int      @id @default(autoincrement())
  nom        String   @db.VarChar(100)
  username   String   @unique @db.VarChar(100)
  password   String   @db.VarChar(100)
  mobile     String?  @db.VarChar(15)
  alanyaID   String?  @db.VarChar(15)
  actif      Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("Admin")
}

model Classe {
  idClasse   Int      @id @default(autoincrement())
  libelle    String   @db.VarChar(100)
  idCycle    Int      @db.SmallInt
  idAdmin    Int      @db.SmallInt
  created_at DateTime @default(now())

  @@map("Classe")
}

model AnneeAcademique {
  idAnnee    Int      @id @default(autoincrement())
  libelle    String   @db.VarChar(200)
  periode    String   @db.VarChar(255)
  created_at DateTime @default(now())
  idAdmin    Int      @db.SmallInt

  @@map("AnneeAcademique")
}

model Trimestre {
  idTrimes Int    @id @default(autoincrement())
  libelle  String @db.VarChar(255)
  periode  String @db.VarChar(255)
  idAca    Int    @db.SmallInt
  idAdmin  Int    @db.SmallInt

  @@map("Trimestre")
}

model Session {
  idSession   Int      @id @default(autoincrement())
  libelle     String   @db.VarChar(255)
  description String   @db.TinyText
  idTrimestre Int      @db.SmallInt
  idPers      Int      @db.SmallInt
  created_at  DateTime @default(now())

  @@map("Session")
}

model Cycle {
  idCycle     Int      @id @default(autoincrement())
  libelle     String   @db.VarChar(100)
  description String   @db.TinyText
  idAdmin     Int      @db.SmallInt
  created     DateTime @default(now())

  @@map("Cycle")
}

model Cours {
  idCours     Int      @id @default(autoincrement())
  libelle     String   @db.VarChar(100)
  note        Float
  coefficient Float
  description String   @db.TinyText
  idLivre     Int      @db.SmallInt
  actif       Int      @db.TinyInt
  idAdmin     Int      @db.SmallInt
  created_at  DateTime @default(now())

  @@map("Cours")
}

model EmploiDuTemps {
  idTemps    Int      @id @default(autoincrement())
  jour       String   @db.VarChar(30)
  heure      String   @db.VarChar(6)
  idClasse   Int      @db.SmallInt
  idCours    Int      @db.SmallInt
  idAdmin    Int      @db.SmallInt
  created_at DateTime @default(now())

  @@map("EmploiDuTemps")
}

model Eleve {
  matricule        Int       @id @default(autoincrement())
  nom              String    @db.VarChar(60)
  prenom           String    @db.VarChar(60)
  dateNaissance    DateTime? @db.Date
  lieuNaissance    String?   @db.VarChar(100)
  sexe             Int       @db.SmallInt
  langue           String    @db.VarChar(30)
  photoURL         String?   @db.VarChar(255)
  actif            Int       @db.TinyInt
  idVilleNaissance Int       @db.SmallInt
  idAdmin          Int       @db.SmallInt
  created_at       DateTime  @default(now())

  @@map("Eleve")
}

model VilleNaissance {
  idVille Int    @id @default(autoincrement())
  libelle String @db.VarChar(100)
  actif   Int    @db.TinyInt

  @@map("VilleNaissance")
}

model Enseignant {
  idEnseignant Int      @id @default(autoincrement())
  idPers       Int      @db.SmallInt
  idCours      Int      @db.SmallInt
  actif        Int      @db.TinyInt
  idAdmin      Int      @db.SmallInt
  created_at   DateTime @default(now())

  @@map("Enseignant")
}

model Titulaire {
  idTitulaire Int      @id @default(autoincrement())
  idPers      Int      @db.SmallInt
  idSalle     Int      @db.SmallInt
  actif       Int      @db.TinyInt
  idAdmin     Int      @db.SmallInt
  created_at  DateTime @default(now())

  @@map("Titulaire")
}

model Frequente {
  idFrequente Int      @id @default(autoincrement())
  idSalle     Int      @db.SmallInt
  idAcademi   Int      @db.SmallInt
  matricule   Int      @db.SmallInt
  commentaire String   @db.VarChar(255)
  idAdmin     Int      @db.SmallInt
  created_at  DateTime @default(now())

  @@map("Frequente")
}
